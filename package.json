{
  "name": "nexolira-design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "packageManager": "npm@12.2.2",
  "workspaces": [
    "packages/tokens",
    "packages/react",
    "apps/docs"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings packages/react/src packages/tokens/src scripts test",
    "test": "vitest run",
    "validate": "node scripts/validate-foundation.mjs",
    "validate:references": "node scripts/validate-foundation.mjs --check-references",
    "pack:verify": "node scripts/pack-smoke.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "jsdom": "31.0.1",
    "oxlint": "1.94.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
